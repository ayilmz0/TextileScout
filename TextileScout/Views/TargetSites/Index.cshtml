@model IEnumerable<TextileScout.Web.Models.TargetSite>
@{
    ViewData["Title"] = "Takip Edilen Siteler";
}

<div class="row g-4 justify-content-center">
    <!-- Sol: Form -->
    <div class="col-lg-4">
        <div class="ts-card p-4">
            <h6 class="fw-bold mb-1">Yeni Site Ekle</h6>
            <p class="text-muted small mb-3">Taranmasını istediğiniz adresi tanımlayın</p>

            <form asp-action="Create" method="post">
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-muted">Site / Marka İsmi</label>
                    <input type="text" name="name" class="form-control ts-input" placeholder="Örn: Zara Erkek Mont" required />
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-muted">Hedef URL</label>
                    <input type="url" name="url" class="form-control ts-input" placeholder="https://..." required />
                </div>
                <button type="submit" class="ts-btn-primary w-100 mt-2">
                    <i class="bi bi-plus-lg me-1"></i> Takiplere Ekle
                </button>
            </form>
        </div>
    </div>

    <!-- Sağ: Liste -->
    <div class="col-lg-7">
        <div class="ts-card p-4">
            <h6 class="fw-bold mb-1">Takipteki Siteler</h6>
            <p class="text-muted small mb-3">Sistemin düzenli olarak kontrol ettiği adresler</p>

            <div class="d-flex flex-column gap-2">
                @foreach (var site in Model)
                {
                    <div class="p-3 border rounded-3 d-flex align-items-center justify-content-between bg-white">
                        <div class="overflow-hidden me-3">
                            <div class="fw-semibold text-dark text-truncate">@site.Name</div>
                            <a href="@site.Url" target="_blank" class="text-muted small text-decoration-none text-truncate d-block">
                                @site.Url <i class="bi bi-box-arrow-up-right ms-1" style="font-size: 0.7rem;"></i>
                            </a>
                        </div>
                        <form asp-action="Delete" method="post" class="m-0">
                            <input type="hidden" name="id" value="@site.Id" />
                            <button type="submit" class="btn btn-light text-danger btn-sm rounded-2 border">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </div>
                }

                @if (!Model.Any())
                {
                    <div class="text-center py-4 text-muted small">
                        Henüz kayıtlı bir site yok. Soldaki formdan ekleyebilirsiniz.
                    </div>
                }
            </div>
        </div>
    </div>
</div>