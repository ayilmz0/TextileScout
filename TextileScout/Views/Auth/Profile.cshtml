@model TextileScout.Web.Models.User
@{
    ViewData["Title"] = "Profilim";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden" style="background: rgba(30, 41, 59, 0.7); backdrop-filter: blur(16px); border: 1px solid rgba(255, 255, 255, 0.1) !important;">
                
                <!-- Üst Banner Katmanı -->
                <div class="p-4 text-center position-relative" style="background: linear-gradient(135deg, rgba(16, 185, 129, 0.2) 0%, rgba(15, 23, 42, 0.8) 100%); border-bottom: 1px solid rgba(255, 255, 255, 0.05);">
                    <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle shadow-sm" style="width: 72px; height: 72px; background: rgba(16, 185, 129, 0.15); border: 2px solid #10b981; color: #10b981;">
                        <i class="fa-solid fa-user-gear fs-2"></i>
                    </div>
                    <h4 class="fw-bold text-white mb-1">@Model.Username</h4>
                    <span class="badge rounded-pill px-3 py-2 fw-semibold" style="background: rgba(16, 185, 129, 0.2); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.4);">
                        <i class="fa-solid fa-shield-halved me-1"></i> @Model.Role Hesabı
                    </span>
                </div>

                <!-- İstatistik Kartları -->
                <div class="card-body p-4">
                    <div class="row g-3 mb-4">
                        <div class="col-6">
                            <div class="p-3 rounded-3 text-center h-100" style="background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.08);">
                                <div class="fs-2 fw-bold" style="color: #38bdf8;">
                                    <i class="fa-solid fa-globe fs-4 me-1"></i>@ViewBag.SiteCount
                                </div>
                                <div class="small text-secondary font-monospace mt-1">Takip Edilen Site</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-3 rounded-3 text-center h-100" style="background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.08);">
                                <div class="fs-2 fw-bold" style="color: #10b981;">
                                    <i class="fa-solid fa-shirt fs-4 me-1"></i>@ViewBag.ProductCount
                                </div>
                                <div class="small text-secondary font-monospace mt-1">Yakalanan Model</div>
                            </div>
                        </div>
                    </div>

                    <!-- Çıkış Yap / Aksiyon Butonu -->
                    <div class="d-grid gap-2">
                        <a href="/Auth/Logout" class="btn py-2.5 rounded-3 fw-semibold text-white d-flex align-items-center justify-content-center" style="background: rgba(239, 68, 68, 0.2); border: 1px solid rgba(239, 68, 68, 0.4); transition: all 0.3s ease;">
                            <i class="fa-solid fa-right-from-bracket me-2" style="color: #fca5a5;"></i> Oturumu Kapat
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>