@model TextileScout.Web.DTOs.RegisterDto
@{
    Layout = "_Layout"; ViewData["Title"] = "Kayıt Ol";
}

<div class="row justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="col-md-5 col-lg-4">
        <div class="ts-card p-4 p-md-5">
            <div class="text-center mb-4">
                <div class="ts-brand-icon mx-auto mb-3" style="width: 48px; height: 48px;"><i class="bi bi-person-plus fs-5"></i></div>
                <h5 class="fw-bold mb-1">Hesap Oluştur</h5>
                <p class="text-muted small mb-0">Kendi rakip radarınızı kurmaya başlayın</p>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger border-0 rounded-3 small py-2 mb-3">@ViewBag.Error</div>
            }

            <form asp-action="Register" method="post">
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-muted">Kullanıcı Adı</label>
                    <input asp-for="Username" class="form-control ts-input" required />
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-muted">Şifre</label>
                    <input asp-for="Password" type="password" class="form-control ts-input" required />
                </div>
                <div class="mb-4">
                    <label class="form-label small fw-semibold text-muted">Şifre Tekrar</label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control ts-input" required />
                </div>
                <button type="submit" class="ts-btn-primary w-100 py-2">Kayıt Ol ve Başla</button>
            </form>
            <div class="text-center mt-3">
                <a asp-action="Login" class="text-decoration-none small text-muted">Zaten hesabınız var mı? <b>Giriş Yap</b></a>
            </div>
        </div>
    </div>
</div>