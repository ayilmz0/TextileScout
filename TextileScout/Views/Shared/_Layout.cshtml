<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TextileScout</title>

    <!-- Google Fonts & Bootstrap 5 & Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.min.css" />

    <style>
            :root {
                --ts-bg: #F8FAFC;
                --ts-card-bg: #FFFFFF;
                --ts-primary: #0F172A;
                --ts-accent: #2563EB;
                --ts-accent-hover: #1D4ED8;
                --ts-text-main: #0F172A;
                --ts-text-muted: #64748B;
                --ts-border: #E2E8F0;
                --ts-radius: 16px;
                --ts-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.05);
                --ts-shadow-hover: 0 20px 25px -5px rgba(15, 23, 42, 0.1);
            }

            body {
                background-color: var(--ts-bg);
                font-family: 'Plus Jakarta Sans', sans-serif;
                color: var(--ts-text-main);
                min-height: 100vh;
            }

            .ts-navbar {
                background: rgba(255, 255, 255, 0.85);
                backdrop-filter: blur(12px);
                border-bottom: 1px solid var(--ts-border);
                padding: 14px 0;
            }

            .ts-brand {
                font-weight: 700;
                font-size: 1.25rem;
                color: var(--ts-primary);
                text-decoration: none;
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .ts-brand-icon {
                width: 36px;
                height: 36px;
                background: var(--ts-accent);
                color: white;
                border-radius: 10px;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .ts-nav-link {
                color: var(--ts-text-muted);
                font-weight: 500;
                font-size: 0.925rem;
                padding: 8px 16px;
                border-radius: 10px;
                text-decoration: none;
                transition: all 0.2s ease;
            }

                .ts-nav-link:hover, .ts-nav-link.active {
                    color: var(--ts-accent);
                    background: rgba(37, 99, 235, 0.06);
                }

            .ts-card {
                background: var(--ts-card-bg);
                border: 1px solid var(--ts-border);
                border-radius: var(--ts-radius);
                box-shadow: var(--ts-shadow);
                transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
                overflow: hidden;
            }

            .ts-card-hover:hover {
                transform: translateY(-4px);
                box-shadow: var(--ts-shadow-hover);
                border-color: rgba(37, 99, 235, 0.3);
            }

            .ts-input {
                border: 1px solid var(--ts-border);
                border-radius: 12px;
                padding: 12px 16px;
                font-size: 0.95rem;
                transition: all 0.2s;
                background: #FAFAFA;
            }

                .ts-input:focus {
                    background: #FFFFFF;
                    border-color: var(--ts-accent);
                    box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.1);
                    outline: none;
                }

            .ts-btn-primary {
                background: var(--ts-accent);
                color: white;
                border: none;
                border-radius: 12px;
                padding: 10px 20px;
                font-weight: 600;
                transition: all 0.2s;
            }

                .ts-btn-primary:hover {
                    background: var(--ts-accent-hover);
                    color: white;
                    transform: translateY(-1px);
                }
    </style>
</head>
<body>

    @{
        var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
        var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();

        // Giriş yapılmışsa VE (Login veya Register sayfalarında DEĞİLSEK) Navbar'ı göster
        bool isAuthPage = currentController == "Auth" && (currentAction == "Login" || currentAction == "Register");
    }

    @if ((User.Identity?.IsAuthenticated ?? false) && !isAuthPage)
    {
        <nav class="navbar navbar-expand-lg ts-navbar sticky-top mb-4" style="z-index: 2000;">
            <div class="container">
                <a class="ts-brand" asp-controller="Home" asp-action="Index">
                    <div class="ts-brand-icon"><i class="bi bi-radar"></i></div>
                    <span>TextileScout</span>
                </a>
                <div class="d-flex align-items-center gap-2">
                    <a class="ts-nav-link @(currentAction == "Index" && currentController == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-grid-fill me-1"></i> Modeller
                    </a>
                    <a class="ts-nav-link @(currentAction == "Approved" ? "active" : "")" asp-controller="Home" asp-action="Approved">
                        <i class="bi bi-heart-fill me-1 text-danger"></i> Beğenilenler
                    </a>
                    <a class="ts-nav-link @(currentController == "TargetSites" ? "active" : "")" asp-controller="TargetSites" asp-action="Index">
                        <i class="bi bi-globe2 me-1"></i> Siteler
                    </a>

                    <!-- PROFİL VE ÇIKIŞ DROPDOWN MENÜSÜ -->
                    <div class="dropdown ms-2">
                        <button class="btn btn-sm btn-light border rounded-pill px-3 py-1 d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle text-primary"></i>
                            <span class="fw-semibold small">@User.Identity?.Name</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3 p-2" style="z-index: 1070;">
                            <li>
                                <a class="dropdown-item rounded-2 small @(currentAction == "Profile" ? "bg-light font-weight-bold" : "")" asp-controller="Auth" asp-action="Profile">
                                    <i class="bi bi-person me-2"></i>Profilim
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item rounded-2 small text-danger" asp-controller="Auth" asp-action="Logout">
                                    <i class="bi bi-box-arrow-right me-2"></i>Çıkış Yap
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </nav>
    }

    <!-- KRİTİK NOKTA: RenderBody HER DURUMDA ÇAĞRILMALIDIR (if bloğunun DIŞINDA) -->
    <div class="container pb-5">
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>