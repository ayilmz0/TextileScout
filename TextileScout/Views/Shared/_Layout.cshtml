<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TextileScout</title>

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
        :root {
            --ts-bg: #0f172a;
            --ts-card-bg: rgba(30, 41, 59, 0.75);
            --ts-primary: #ffffff;
            --ts-accent: #10b981;
            --ts-accent-hover: #059669;
            --ts-text-main: #f8fafc;
            --ts-text-muted: #cbd5e1;
            --ts-border: rgba(255, 255, 255, 0.12);
            --ts-radius: 16px;
            --ts-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
        }

        body {
            background-color: var(--ts-bg);
            font-family: 'Plus Jakarta Sans', sans-serif;
            color: var(--ts-text-main);
            min-height: 100vh;
        }

        .ts-navbar {
            background: rgba(15, 23, 42, 0.9);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-bottom: 1px solid var(--ts-border);
            padding: 14px 0;
        }

        .ts-brand {
            font-weight: 700;
            font-size: 1.25rem;
            color: #ffffff;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .ts-brand span span { color: var(--ts-accent); }

        .ts-brand-icon {
            width: 42px;
            height: 42px;
            background: linear-gradient(135deg, rgba(16, 185, 129, 0.3), rgba(16, 185, 129, 0.1));
            border: 1px solid rgba(16, 185, 129, 0.5);
            color: var(--ts-accent);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            box-shadow: 0 4px 12px rgba(16, 185, 129, 0.2);
        }

        .ts-nav-link {
            color: var(--ts-text-muted);
            font-weight: 500;
            font-size: 0.925rem;
            padding: 8px 16px;
            border-radius: 10px;
            text-decoration: none;
            transition: all 0.2s ease;
        }

        .ts-nav-link:hover, .ts-nav-link.active {
            color: #ffffff;
            background: rgba(16, 185, 129, 0.15);
        }

        .ts-nav-link.active {
            color: #34d399;
            font-weight: 600;
        }
    </style>
</head>
<body>

    @{
        var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
        var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
        bool isAuthPage = currentController == "Auth" && (currentAction == "Login" || currentAction == "Register");
    }

    @if ((User.Identity?.IsAuthenticated ?? false) && !isAuthPage)
    {
        <nav class="navbar navbar-expand-lg ts-navbar sticky-top mb-4" style="z-index: 2000;">
            <div class="container">
                <!-- LANDING'DEKİ GÖZ LOGOSU ENTEGRE EDİLDİ -->
                <a class="ts-brand" asp-controller="Home" asp-action="Index">
                    <div class="ts-brand-icon">
                        <i class="fa-solid fa-eye"></i>
                    </div>
                    <span>Textile<span>Scout</span></span>
                </a>
                
                <div class="d-flex align-items-center gap-2">
                    <a class="ts-nav-link @(currentAction == "Index" && currentController == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">
                        <i class="fa-solid fa-shirt me-1"></i> Modeller
                    </a>
                    <a class="ts-nav-link @(currentAction == "Approved" ? "active" : "")" asp-controller="Home" asp-action="Approved">
                        <i class="fa-solid fa-heart me-1 text-danger"></i> Beğenilenler
                    </a>
                    <a class="ts-nav-link @(currentController == "TargetSites" ? "active" : "")" asp-controller="TargetSites" asp-action="Index">
                        <i class="fa-solid fa-globe me-1"></i> Siteler
                    </a>

                    <!-- PROFİL DROPDOWN -->
                    <div class="dropdown ms-2">
                        <button class="btn btn-sm border rounded-pill px-3 py-1.5 d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="background: rgba(15, 23, 42, 0.6); border-color: rgba(255,255,255,0.2) !important; color: #f8fafc;">
                            <i class="fa-solid fa-user-circle" style="color: #10b981;"></i>
                            <span class="fw-semibold small">@User.Identity?.Name</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end shadow-lg border-0 rounded-3 p-2" style="z-index: 1070; background: #1e293b; border: 1px solid rgba(255,255,255,0.15) !important;">
                            <li>
                                <a class="dropdown-item rounded-2 small text-light @(currentAction == "Profile" ? "active" : "")" asp-controller="Auth" asp-action="Profile">
                                    <i class="fa-solid fa-user me-2"></i>Profilim
                                </a>
                            </li>
                            <li><hr class="dropdown-divider opacity-25"></li>
                            <li>
                                <a class="dropdown-item rounded-2 small text-danger" asp-controller="Auth" asp-action="Logout">
                                    <i class="fa-solid fa-right-from-bracket me-2"></i>Çıkış Yap
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </nav>
    }

    <div class="container pb-5">
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>