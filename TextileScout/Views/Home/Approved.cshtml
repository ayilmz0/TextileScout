@model TextileScout.Web.DTOs.ProductListViewModel
@{
    ViewData["Title"] = "Beğenilen Modeller";
}

<div class="dashboard-hero mb-4 rounded-4 overflow-hidden position-relative shadow-lg p-4 p-md-5" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); border: 1px solid rgba(255, 255, 255, 0.1);">
    <div class="position-absolute top-0 end-0 h-100 w-50" style="background: radial-gradient(circle at top right, rgba(245, 158, 11, 0.12), transparent 60%);"></div>

    <div class="position-relative z-2 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-4">
        <div>
            <span class="badge rounded-pill mb-2 px-3 py-1.5 fw-semibold" style="background: rgba(245, 158, 11, 0.15); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.3);">
                <i class="fa-solid fa-bookmark me-1"></i> Arşiv ve Koleksiyon
            </span>
            <h3 class="fw-bold text-white mb-2" style="font-size: 2rem;">Beğenilen Modeller</h3>
            <p class="text-secondary mb-0" style="font-size: 1.05rem;">Üretime veya takibe alınan kayıtlı kıyafet modelleriniz burada listelenir.</p>
        </div>

        <div class="text-md-end text-start">
            <span class="badge rounded-pill px-3 py-2 font-monospace" style="background: rgba(16, 185, 129, 0.2); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.4); font-size: 0.85rem;">
                Sayfa @Model.CurrentPage / @Model.TotalPages
            </span>
        </div>
    </div>
</div>

@if (!Model.Products.Any())
{
    <!-- BOŞ DURUM KARTI -->
    <div class="card border-0 text-center py-5 rounded-4 shadow-lg ts-glass-card mt-4" style="background: rgba(30, 41, 59, 0.6); backdrop-filter: blur(16px); border: 1px solid rgba(255, 255, 255, 0.1) !important;">
        <div class="card-body py-5">
            <div class="mx-auto mb-4 d-flex align-items-center justify-content-center rounded-circle" style="width: 80px; height: 80px; background: rgba(245, 158, 11, 0.1); border: 2px solid rgba(245, 158, 11, 0.3); color: #fbbf24; font-size: 2rem;">
                <i class="fa-regular fa-heart"></i>
            </div>
            <h4 class="text-white fw-bold mb-2">Henüz Beğenilen Model Yok</h4>
            <p class="text-secondary mb-4">"Gelen Modeller" akışından beğendiğiniz ürünler bu arşive otomatik olarak eklenecektir.</p>
            <a href="/Home/Index" class="btn px-4 py-2.5 rounded-pill fw-semibold text-white" style="background: #10b981; border: none; box-shadow: 0 4px 15px rgba(16, 185, 129, 0.3);">
                <i class="fa-solid fa-arrow-left me-2"></i> Modelleri Keşfet
            </a>
        </div>
    </div>
}
else
{
    <!-- LÜKS MODA KARTLARI -->
    <div class="row g-4">
        @foreach (var item in Model.Products)
        {
            <div class="col-sm-6 col-md-4 col-lg-3">
                <div class="card h-100 border-0 rounded-4 overflow-hidden ts-fashion-card position-relative" style="background: rgba(30, 41, 59, 0.6); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.08) !important; transition: all 0.3s ease;">
                    
                    <!-- Onaylandı / Beğenildi Rozeti -->
                    <span class="badge position-absolute top-0 start-0 m-3 z-3 shadow-sm d-flex align-items-center gap-1" style="background: #10b981; color: #fff; padding: 6px 12px; font-size: 0.75rem; letter-spacing: 0.5px;">
                        <i class="fa-solid fa-heart me-1"></i> @item.SourceSite
                    </span>

                    <!-- Görsel Alanı -->
                    <div style="background: #0b1120; height: 380px; overflow: hidden; position: relative;">
                        <img src="@item.ImageUrl" class="w-100 h-100 ts-img" alt="@item.SourceSite" loading="lazy" style="object-fit: cover; object-position: top; transition: transform 0.6s ease;" />
                    </div>

                    <!-- Kart Gövdesi -->
                    <div class="card-body d-flex flex-column justify-content-between p-3">
                        <div class="mb-3">
                            <div class="text-secondary small font-monospace d-flex align-items-center">
                                <i class="fa-regular fa-clock me-1.5"></i> @item.DetectedAt.ToString("dd MMM yyyy · HH:mm")
                            </div>
                        </div>

                        <!-- LİSTEDEN SİL BUTONU -->
                        <div>
                            <form asp-action="DeleteProduct" method="post" class="m-0">
                                <input type="hidden" name="id" value="@item.Id" />
                                <input type="hidden" name="returnUrl" value="/Home/Approved" />
                                <button type="submit" class="btn w-100 rounded-3 ts-btn-delete py-2 d-flex align-items-center justify-content-center gap-2">
                                    <i class="fa-solid fa-trash-can"></i> Listeden Sil
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- MODERN SAYFALAMA (PAGINATION) -->
    @if (Model.TotalPages > 1)
    {
        <div class="d-flex justify-content-center mt-5 mb-4">
            <nav aria-label="Sayfalama">
                <ul class="pagination pagination-sm m-0" style="gap: 6px;">
                    <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                        <a class="page-link rounded-3 border-0 text-white shadow-sm px-3 py-2" href="?page=@(Model.CurrentPage - 1)" style="background: rgba(30, 41, 59, 0.8) !important; border: 1px solid rgba(255,255,255,0.1) !important;">
                            <i class="fa-solid fa-chevron-left"></i> Önceki
                        </a>
                    </li>
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item">
                            <a class="page-link rounded-3 border-0 shadow-sm px-3 py-2 fw-bold text-white" href="?page=@i" 
                               style="@(i == Model.CurrentPage ? "background: #10b981 !important; border-color: #10b981 !important;" : "background: rgba(30, 41, 59, 0.8) !important; border: 1px solid rgba(255,255,255,0.1) !important;")">
                                @i
                            </a>
                        </li>
                    }
                    <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                        <a class="page-link rounded-3 border-0 text-white shadow-sm px-3 py-2" href="?page=@(Model.CurrentPage + 1)" style="background: rgba(30, 41, 59, 0.8) !important; border: 1px solid rgba(255,255,255,0.1) !important;">
                            Sonraki <i class="fa-solid fa-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    }
}

<!-- SAYFAYA ÖZEL STİLLER -->
<style>
    .ts-glass-card {
        background: rgba(30, 41, 59, 0.6);
        backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
    }

    .ts-fashion-card {
        background: rgba(30, 41, 59, 0.5);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.08) !important;
        box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    
    .ts-fashion-card:hover {
        transform: translateY(-8px);
        border-color: rgba(16, 185, 129, 0.4) !important;
        box-shadow: 0 20px 40px rgba(0,0,0,0.4);
    }

    .ts-fashion-card:hover .ts-img {
        transform: scale(1.06);
    }

    .ts-btn-delete {
        background: rgba(239, 68, 68, 0.1);
        color: #fca5a5;
        border: 1px solid rgba(239, 68, 68, 0.25);
        font-weight: 600;
        font-size: 0.85rem;
        transition: all 0.3s ease;
    }

    .ts-btn-delete:hover {
        background: rgba(239, 68, 68, 0.9);
        color: #fff;
        border-color: #ef4444;
        box-shadow: 0 4px 15px rgba(239, 68, 68, 0.3);
    }
</style>